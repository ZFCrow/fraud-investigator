# Copy to .env and fill in. Hostnames are the Compose service names.
PYTHONUNBUFFERED=1
DEBUG=0
ENVIRONMENT=DEVELOPMENT

# app database user -- created by db_init/03_create_users.sh.
# DB_PASSWORD must be the same value as APP_DB_PASSWORD in .env.db
DB_USER=shop
DB_PASSWORD=shop_dev
DB_HOST=db
DB_PORT=5432
DB_NAME=shop
# read-only user the agent's own SQL runs as -- created by db_init/03_create_users.sh.
# DB_READER_PASSWORD must be the same value as READER_DB_PASSWORD in .env.db
DB_READER_USER=shop_reader
DB_READER_PASSWORD=shop_reader_dev

QDRANT_HOST=qdrant
QDRANT_PORT=6333

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=

# Nebius Token Factory
NEBIUS_API_KEY=
MODEL_AGENT=nvidia/nemotron-3-super-120b-a12b
MODEL_AGENT_CONTEXT_WINDOW=131072
# Embedding model for the session vector store (dense half; sparse is local BM25).
# Changing either value means re-ingesting into a fresh collection.
EMBEDDING_MODEL=Qwen/Qwen3-Embedding-8B
EMBEDDING_DIM=1024

# Optional, exact ids from the Token Factory console; each falls back to MODEL_AGENT when empty.
# MODEL_REASONING writes answers that combine two or more tool results (Nemotron 3 Ultra),
# MODEL_FAST writes follow-up questions and the out-of-scope reply, MODEL_JUDGE scores answers.
MODEL_REASONING=nvidia/Nemotron-3-Ultra-550b-a55b
MODEL_FAST=nvidia/Nemotron-3_5-Lightning
MODEL_JUDGE=

# Tavily web search (search_fraud_patterns tool); empty -> the tool returns an error and the
# agent answers from store data only
TAVILY_API_KEY=

# Public demo only (0 = off): questions per visitor per minute / per day across all visitors
RATE_LIMIT_PER_MINUTE=0
RATE_LIMIT_PER_DAY=0
