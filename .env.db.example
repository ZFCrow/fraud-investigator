# Copy to .env.db. Read by the db container only the first time its data volume is created.

# Postgres superuser
POSTGRES_USER=postgres
POSTGRES_PASSWORD=

# Password of the app user `shop` (created by db_init/03_create_users.sh).
# Must be the same value as DB_PASSWORD in .env. Use your own for anything public;
# shop_dev is the local-dev default that migrations/alembic.ini also assumes.
APP_DB_PASSWORD=shop_dev
